# Copy this file to .env, fill in your values, then run:
#     docker compose up -d --build


# Finnhub API key: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# PostgreSQL credentials (any values you like; used inside Docker only).
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=change_me_something_strong

# --- Pipeline behavior (defaults shown; all optional) -----------------------

# Comma-separated stock symbols to fetch on every run.
STOCK_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA

# Finnhub client tuning. Free tier = 60 requests/minute; the inter-request
# delay keeps a full symbol batch comfortably below that ceiling.
FINNHUB_TIMEOUT=10          # seconds before an HTTP request gives up
FINNHUB_MAX_RETRIES=3       # retries for transient errors (network, 429, 5xx)
FINNHUB_RETRY_BACKOFF=1     # base seconds for exponential backoff (1, 2, 4...)
FINNHUB_INTER_REQUEST_DELAY=1.1  # pause between symbols, seconds

# --- Docker internals (rarely changed; safe defaults) -----------------------

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dagster          # Dagster system-storage database
STOCK_DB_NAME=stockdata      # pipeline data database (created by init.sql)
